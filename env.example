# Copy this file to .env.local and set the public Supabase project values below.
# These values must point to the same Supabase project used by the hosted YourThumb backend.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API requests are forwarded to the official hosted app; only HTTPS yourthumb.tech hosts are allowed.
YOURTHUMB_LIVE_BACKEND_URL=https://yourthumb.tech

# Never place real OpenAI, Supabase service-role, Razorpay, PayPal, Canva, QStash, GitHub, or Telegram secrets in this repository.
